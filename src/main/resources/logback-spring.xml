<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- One JSON object per line. MDC carries request_id, user_id, show_id, reservation_id. -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
            <includeMdcKeyName>request_id</includeMdcKeyName>
            <includeMdcKeyName>user_id</includeMdcKeyName>
            <includeMdcKeyName>show_id</includeMdcKeyName>
            <includeMdcKeyName>reservation_id</includeMdcKeyName>
            <customFields>{"service":"seat-reservation"}</customFields>
        </encoder>
    </appender>

    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="JSON"/>
        <queueSize>8192</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
    </appender>

    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="ASYNC"/>
    </root>
</configuration>
